# VBrowser Konfiguration

# Backend
HOST=0.0.0.0
PORT=8080

# Datenbank (persistent)
DBPATH=/appdata/browser.db

# Security
SECRETKEY=secret

# Docker
DOCKERHOST=unix:///var/run/docker.sock
DOCKERIMAGE=jlesage/firefox:latest

# Reverse Proxy
# Wildcard DNS erforderlich (*.vbrowser.sjll.de)
BASE_DOMAIN=vbrowser.de
PROXY_NETWORK=vbrowser_proxy
TRAEFIK_ENTRYPOINT=web

# TLS (wird durch Pangolin Reverse Proxy übernommen)
USE_TLS=false

# Session Timeout in Sekunden
SESSION_TIMEOUT=300


PROTOCOL=https

