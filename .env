# Virtual Browser Server Configuration

# Host configuration
HOST=0.0.0.0
PORT=8000
HOST_IP=192.168.1.100

# Security
SECRET_KEY=change-me-in-production-$(openssl rand -hex 32)

# Database
DB_PATH=./data/browser.db

# Logging
LOG_DIR=./data/logs

# Docker
DOCKER_IMAGE=virtual-browser:latest

# Container resources
CONTAINER_RAM=768m
CONTAINER_CPUS=0.5

# VNC Port allocation
NOVNC_PORT_START=6080
