# VBrowser Konfiguration

# Backend
HOST=0.0.0.0
PORT=8080

# Datenbank (persistent)
DBPATH=/appdata/browser.db

# Security - WICHTIG: Ändere diesen Key in Produktion!
SECRETKEY=change-this-secret-key-to-something-secure

# Docker
DOCKERHOST=unix:///var/run/docker.sock
DOCKERIMAGE=jlesage/firefox:latest

# Traefik / Reverse Proxy
# WICHTIG: Passe diese Domain an! Wildcard DNS erforderlich (*.vbrowser.example.com)
BASE_DOMAIN=vbrowser.home
PROXY_NETWORK=vbrowser_proxy
TRAEFIK_ENTRYPOINT=web

# TLS / HTTPS
# Für lokale Entwicklung: false
# Für Produktion mit Let's Encrypt: true
USE_TLS=false

# Let's Encrypt Resolver (nur wenn USE_TLS=true)
# Uncomment und konfiguriere Let's Encrypt in docker-compose.yml
# CERT_RESOLVER=letsencrypt


#Timeout for Sessions of inactive users in secconds
SESSION_TIMEOUT=30   # 5 Minuten
