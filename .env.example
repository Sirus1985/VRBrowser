# ============================================================
# VBrowser Konfiguration
# Kopieren: cp .env.example .env  und Werte anpassen
# ============================================================

# --- Pflichtfelder ---
SECRETKEY=changeme
BASE_DOMAIN=vbrowser.de
TUNNEL_TOKEN=

# --- Optionale Einstellungen ---
HOST=0.0.0.0
PORT=8080
USE_TLS=false

# Pfad zur SQLite-Datenbank
DBPATH=/appdata/vbrowser.db

# Pfad fuer Browser-Profile
PROFILES_BASE=/appdata/profiles

# Docker
DOCKERHOST=unix:///var/run/docker.sock
PROXY_NETWORK=vbrowser_proxy

# Session-Timeouts (Sekunden)
SESSION_TIMEOUT=300
MAX_SESSION_DURATION=0

# ============================================================
# Seccomp-Konfiguration fuer Browser-Container (optional)
# ============================================================

# Modus: off (Standard) | unconfined | profile
# off        = kein Seccomp gesetzt (Docker-Standard)
# unconfined = Seccomp deaktiviert (maximale Kompatibilitaet, weniger sicher)
# profile    = eigenes JSON-Profil verwenden (siehe BROWSER_SECCOMP_PROFILE)
BROWSER_SECCOMP_MODE=off

# Pfad zum Seccomp-JSON-Profil (nur relevant wenn MODE=profile)
# Die Datei muss im Backend-Container unter diesem Pfad erreichbar sein.
# In docker-compose.yml ist /opt/vbrowser/seccomp_profile.json bereits gemountet.
BROWSER_SECCOMP_PROFILE=/opt/vbrowser/seccomp_profile.json

# Kommagetrennte Liste von Image-Basisnamen, fuer die Seccomp gilt
# Beispiel: jlesage/firefox,jlesage/chromium
BROWSER_SECCOMP_IMAGES=jlesage/firefox

# Seccomp auf ALLE vbrowser-Images anwenden (true/false)
# Ueberschreibt BROWSER_SECCOMP_IMAGES wenn true
BROWSER_SECCOMP_ALL_IMAGES=false
